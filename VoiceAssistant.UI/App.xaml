<!-- VoiceAssistant.UI/App.xaml -->
<Application x:Class="VoiceAssistant.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VoiceAssistant.UI"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Startup="Application_Startup"
             Exit="Application_Exit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Cyan" SecondaryColor="LightBlue" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Common Styles -->
            <Style x:Key="WindowStyle" TargetType="Window">
                <Setter Property="AllowsTransparency" Value="True" />
                <Setter Property="WindowStyle" Value="None" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Topmost" Value="True" />
                <Setter Property="ShowInTaskbar" Value="False" />
                <Setter Property="ResizeMode" Value="NoResize" />
            </Style>
            
            <Style x:Key="PulseEllipseStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="120" />
                <Setter Property="Height" Value="120" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Opacity" Value="0.6" />
                <Setter Property="Fill">
                    <Setter.Value>
                        <RadialGradientBrush>
                            <GradientStop Color="#1976D2" Offset="0.0" />
                            <GradientStop Color="#0D47A1" Offset="1.0" />
                        </RadialGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <Style x:Key="CommandBubbleStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Background" Value="#283593" />
                <Setter Property="BorderBrush" Value="#3F51B5" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="4" Opacity="0.3" />
                    </Setter.Value>
                </Setter>
            </Style>
            
            <Style x:Key="CommandTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MaxWidth" Value="300" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<!-- VoiceAssistant.UI/MainWindow.xaml -->
<Window x:Class="VoiceAssistant.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VoiceAssistant.UI"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Voice Assistant" Height="200" Width="300"
        Style="{StaticResource WindowStyle}"
        LocationChanged="Window_LocationChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Grid>
        <!-- Main content -->
        <Grid x:Name="MainContent">
            <!-- Pulsing circle background -->
            <Ellipse x:Name="PulseEllipse" Style="{StaticResource PulseEllipseStyle}" />
            
            <!-- Status icon -->
            <materialDesign:PackIcon x:Name="StatusIcon"
                                     Kind="Microphone"
                                     Width="48" Height="48"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="White" />
            
            <!-- Command bubble -->
            <Border x:Name="CommandBubble"
                    Style="{StaticResource CommandBubbleStyle}"
                    Visibility="Collapsed"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20">
                <TextBlock x:Name="CommandText"
                           Style="{StaticResource CommandTextStyle}" />
            </Border>
            
            <!-- Close button -->
            <Button x:Name="CloseButton"
                    Width="24" Height="24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,5,5,0"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Click="CloseButton_Click">
                <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
            </Button>
        </Grid>
        
        <!-- Taskbar icon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="/Resources/microphone.ico"
                        ToolTipText="Voice Assistant"
                        TrayLeftMouseDown="TrayIcon_TrayLeftMouseDown">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show Window" Click="ShowWindow_Click" />
                    <MenuItem Header="Settings" Click="Settings_Click" />
                    <Separator />
                    <MenuItem Header="Exit" Click="Exit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
    
    <Window.Triggers>
        <!-- Pulse animation -->
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation 
                        Storyboard.TargetName="PulseEllipse"
                        Storyboard.TargetProperty="Width"
                        From="120" To="150" Duration="0:0:1.5" />
                    <DoubleAnimation 
                        Storyboard.TargetName="PulseEllipse"
                        Storyboard.TargetProperty="Height"
                        From="120" To="150" Duration="0:0:1.5" />
                    <DoubleAnimation 
                        Storyboard.TargetName="PulseEllipse"
                        Storyboard.TargetProperty="Opacity"
                        From="0.6" To="0.3" Duration="0:0:1.5" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>

<!-- VoiceAssistant.UI/SettingsWindow.xaml -->
<Window x:Class="VoiceAssistant.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VoiceAssistant.UI"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Voice Assistant Settings" 
        Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Voice Assistant Settings" 
                   Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                   Margin="0,0,0,16" />
        
        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- General Settings -->
                <materialDesign:Card Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <TextBlock Text="General" 
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                   Margin="0,0,0,8" />
                        
                        <CheckBox x:Name="StartWithWindowsCheckBox" 
                                  Content="Start with Windows" 
                                  Margin="0,8,0,0" />
                        
                        <CheckBox x:Name="MinimizeToTrayCheckBox" 
                                  Content="Minimize to system tray" 
                                  IsChecked="True"
                                  Margin="0,8,0,0" />
                    </StackPanel>
                </materialDesign:Card>
                
                <!-- Wake Word Settings -->
                <materialDesign:Card Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Wake Word Detection" 
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                   Margin="0,0,0,8" />
                        
                        <TextBlock Text="Sensitivity" Margin="0,8,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SensitivitySlider" 
                                    Minimum="0" Maximum="1" 
                                    Value="0.7" 
                                    TickFrequency="0.1"
                                    TickPlacement="BottomRight" 
                                    IsSnapToTickEnabled="True" />
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding ElementName=SensitivitySlider, Path=Value, StringFormat=N1}" 
                                       VerticalAlignment="Center" 
                                       Margin="16,0,0,0" />
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>
                
                <!-- Visual Settings -->
                <materialDesign:Card Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Appearance" 
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                   Margin="0,0,0,8" />
                        
                        <TextBlock Text="Display Mode" Margin="0,8,0,4" />
                        <ComboBox x:Name="DisplayModeComboBox" SelectedIndex="0" Margin="0,0,0,8">
                            <ComboBoxItem Content="Always Visible" />
                            <ComboBoxItem Content="Show Only When Active" />
                            <ComboBoxItem Content="Minimize to Tray" />
                        </ComboBox>
                        
                        <CheckBox x:Name="TransparencyCheckBox" 
                                  Content="Enable Transparency" 
                                  IsChecked="True"
                                  Margin="0,8,0,0" />
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,16,0,0">
            <Button Content="Cancel" 
                    Style="{StaticResource MaterialDesignOutlinedButton}" 
                    Margin="0,0,8,0"
                    Click="CancelButton_Click" />
            <Button Content="Save" 
                    Style="{StaticResource MaterialDesignRaisedButton}" 
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>