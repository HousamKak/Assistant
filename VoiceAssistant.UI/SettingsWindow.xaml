<Window x:Class="VoiceAssistant.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VoiceAssistant.UI"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Voice Assistant Settings" 
        Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Voice Assistant Settings" 
                   Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                   Margin="0,0,0,16" />
        
        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- General Settings -->
                <materialDesign:Card Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <TextBlock Text="General" 
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                   Margin="0,0,0,8" />
                        
                        <CheckBox x:Name="StartWithWindowsCheckBox" 
                                  Content="Start with Windows" 
                                  Margin="0,8,0,0" />
                        
                        <CheckBox x:Name="MinimizeToTrayCheckBox" 
                                  Content="Minimize to system tray" 
                                  IsChecked="True"
                                  Margin="0,8,0,0" />
                    </StackPanel>
                </materialDesign:Card>
                
                <!-- Wake Word Settings -->
                <materialDesign:Card Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Wake Word Detection" 
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                   Margin="0,0,0,8" />
                        
                        <TextBlock Text="Sensitivity" Margin="0,8,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SensitivitySlider" 
                                    Minimum="0" Maximum="1" 
                                    Value="0.7" 
                                    TickFrequency="0.1"
                                    TickPlacement="BottomRight" 
                                    IsSnapToTickEnabled="True" />
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding ElementName=SensitivitySlider, Path=Value, StringFormat=N1}" 
                                       VerticalAlignment="Center" 
                                       Margin="16,0,0,0" />
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>
                
                <!-- Visual Settings -->
                <materialDesign:Card Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Appearance" 
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                   Margin="0,0,0,8" />
                        
                        <TextBlock Text="Display Mode" Margin="0,8,0,4" />
                        <ComboBox x:Name="DisplayModeComboBox" SelectedIndex="0" Margin="0,0,0,8">
                            <ComboBoxItem Content="Always Visible" />
                            <ComboBoxItem Content="Show Only When Active" />
                            <ComboBoxItem Content="Minimize to Tray" />
                        </ComboBox>
                        
                        <CheckBox x:Name="TransparencyCheckBox" 
                                  Content="Enable Transparency" 
                                  IsChecked="True"
                                  Margin="0,8,0,0" />
                    </StackPanel>
                </materialDesign:Card>
                
                <!-- Text-to-Speech Settings -->
                <materialDesign:Card Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Text-to-Speech" 
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                   Margin="0,0,0,8" />
                        
                        <CheckBox x:Name="EnableTtsCheckBox" 
                                  Content="Enable speech responses" 
                                  IsChecked="True"
                                  Margin="0,8,0,8" />
                        
                        <TextBlock Text="Wake Word Response:" Margin="0,8,0,4" />
                        <TextBox x:Name="ResponsePhraseTextBox"
                                 Text="Yes, I'm listening"
                                 Margin="0,0,0,8" />
                        
                        <TextBlock Text="Voice:" Margin="0,8,0,4" />
                        <ComboBox x:Name="VoiceSelectionComboBox"
                                  Margin="0,0,0,8"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Name" />
                        
                        <TextBlock Text="Speech Rate:" Margin="0,8,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SpeechRateSlider" 
                                    Minimum="-10" Maximum="10" 
                                    Value="0" 
                                    TickFrequency="1"
                                    TickPlacement="BottomRight" 
                                    IsSnapToTickEnabled="True" />
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding ElementName=SpeechRateSlider, Path=Value, StringFormat=N0}" 
                                       VerticalAlignment="Center" 
                                       Margin="16,0,0,0" />
                        </Grid>
                        
                        <TextBlock Text="Volume:" Margin="0,8,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="VolumeSlider" 
                                    Minimum="0" Maximum="100" 
                                    Value="100" 
                                    TickFrequency="10"
                                    TickPlacement="BottomRight" 
                                    IsSnapToTickEnabled="True" />
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat=N0}" 
                                       VerticalAlignment="Center" 
                                       Margin="16,0,0,0" />
                        </Grid>
                        
                        <Button Content="Test Speech"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,0"
                                Click="TestSpeech_Click" />
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,16,0,0">
            <Button Content="Cancel" 
                    Style="{StaticResource MaterialDesignOutlinedButton}" 
                    Margin="0,0,8,0"
                    Click="CancelButton_Click" />
            <Button Content="Save" 
                    Style="{StaticResource MaterialDesignRaisedButton}" 
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>