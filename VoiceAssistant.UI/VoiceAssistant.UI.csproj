<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Change from WinExe to Exe to show console window for better debugging -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoiceAssistant.Core\VoiceAssistant.Core.csproj" />
    <Resource Include="resources\microphone.ico" />
    
    <!-- Ensure sound file is properly included and copied to output directory -->
    <Content Include="Resources\omnitrix.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- Add extra verbose tracking of the sound file -->
    <None Update="Resources\omnitrix.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="MaterialDesignThemes" Version="4.9.0" />
    <PackageReference Include="MaterialDesignColors" Version="2.1.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.4" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

  <!-- Add a build event to verify the sound file -->
  <Target Name="VerifySoundFile" AfterTargets="Build">
    <Message Importance="high" Text="Verifying sound file..." />
    <Message Importance="high" Text="Source path: $(ProjectDir)Resources\omnitrix.mp3" />
    <Message Importance="high" Text="Output path: $(OutputPath)Resources\omnitrix.mp3" />
    
    <Error Condition="!Exists('$(ProjectDir)Resources\omnitrix.mp3')" 
           Text="Source sound file not found at $(ProjectDir)Resources\omnitrix.mp3" />
    
    <Message Importance="high" Text="Source sound file exists" Condition="Exists('$(ProjectDir)Resources\omnitrix.mp3')" />
  </Target>
</Project>